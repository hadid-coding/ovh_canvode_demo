# customer360_kafka_to_postgresql — Spark pipeline Docker image
# Generated by Canvode Docker compiler
# Multi-stage build: dependencies → runtime

# ── Stage 1: dependency builder ────────────────────────────────────────────────
FROM python:3.11-slim AS builder

WORKDIR /build

# System deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential curl \
    && rm -rf /var/lib/apt/lists/*

# Python deps
COPY spark/requirements.txt .
RUN pip install --upgrade pip && \
    pip install --no-cache-dir --prefix=/install -r requirements.txt

# ── Stage 2: Spark runtime ─────────────────────────────────────────────────────
FROM openjdk:17-jre-slim AS spark-base

ARG SPARK_VERSION=3.5.1
ARG HADOOP_VERSION=3

ENV SPARK_HOME=/opt/spark
ENV PATH="${SPARK_HOME}/bin:${SPARK_HOME}/sbin:${PATH}"
ENV PYSPARK_PYTHON=python3

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip curl wget tini \
    && rm -rf /var/lib/apt/lists/*

RUN wget -qO- \
    "https://archive.apache.org/dist/spark/spark-${SPARK_VERSION}/spark-${SPARK_VERSION}-bin-hadoop${HADOOP_VERSION}.tgz" \
    | tar xz -C /opt/ && \
    mv /opt/spark-${SPARK_VERSION}-bin-hadoop${HADOOP_VERSION} /opt/spark

# Download required JDBC/connector JARs
RUN curl -L https://jdbc.postgresql.org/download/postgresql-42.7.1.jar -o /opt/spark/jars/$(basename https://jdbc.postgresql.org/download/postgresql-42.7.1.jar)

# ── Stage 3: final image ───────────────────────────────────────────────────────
FROM spark-base

WORKDIR /app

# Copy Python deps from builder
COPY --from=builder /install /usr/local
RUN pip3 install --no-cache-dir "psycopg2-binary>=2.9.0" \
    "SQLAlchemy>=2.0.0" \
    "confluent-kafka>=2.3.0"

# Copy pipeline code
COPY spark/pipeline.py .

# Non-root user for security
RUN groupadd -r spark && useradd -r -g spark -u 1000 spark && \
    chown -R spark:spark /app /opt/spark/work-dir
USER spark

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["python3", "/app/pipeline.py"]

# ── Metadata ──────────────────────────────────────────────────────────────────
LABEL maintainer="data-team" \
      pipeline="customer360_kafka_to_postgresql" \
      source="kafka" \
      sink="postgresql" \
      generated-by="Canvode"
