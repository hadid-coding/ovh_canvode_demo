# customer360_kafka_to_postgresql — Terraform infrastructure
# Generated by Canvode IR compiler
# Deploys Spark pipeline via Kubernetes Spark Operator

terraform {
  required_version = ">= 1.5.0"
  required_providers {
    kubernetes = {
      source  = "hashicorp/kubernetes"
      version = "~> 2.24"
    }
    helm = {
      source  = "hashicorp/helm"
      version = "~> 2.12"
    }
  }
  # Backend values are supplied at init time because Terraform backends cannot
  # reference input variables:
  # terraform init   #   -backend-config="bucket=<state-bucket>"   #   -backend-config="key=pipelines/customer360_kafka_to_postgresql/terraform.tfstate"   #   -backend-config="region=<aws-region>"
  backend "s3" {}
}

# ── Providers ──────────────────────────────────────────────────────────────────

provider "kubernetes" {
  config_path    = var.kubeconfig_path
  config_context = var.kube_context
}

provider "helm" {
  kubernetes {
    config_path    = var.kubeconfig_path
    config_context = var.kube_context
  }
}

# ── Namespace ──────────────────────────────────────────────────────────────────

resource "kubernetes_namespace" "pipelines" {
  metadata {
    name = var.namespace
    labels = {
      "app.kubernetes.io/managed-by" = "canvode"
      "app.kubernetes.io/component"  = "data-pipeline"
    }
  }
}

# ── Spark Operator (if not already installed) ─────────────────────────────────

resource "helm_release" "spark_operator" {
  name             = "spark-operator"
  repository       = "https://kubeflow.github.io/spark-operator"
  chart            = "spark-operator"
  version          = "1.3.3"
  namespace        = "spark-operator"
  create_namespace = true

  set {
    name  = "webhook.enable"
    value = "true"
  }
  set {
    name  = "metrics.enable"
    value = "true"
  }
}

# ── Service Account & RBAC ────────────────────────────────────────────────────

resource "kubernetes_service_account" "spark" {
  metadata {
    name      = "spark-customer360-kafka-to-postgresql"
    namespace = kubernetes_namespace.pipelines.metadata[0].name
    labels = {
      "app" = "customer360-kafka-to-postgresql"
    }
  }
  depends_on = [kubernetes_namespace.pipelines]
}

resource "kubernetes_cluster_role_binding" "spark" {
  metadata {
    name = "spark-customer360-kafka-to-postgresql-role-binding"
  }
  role_ref {
    api_group = "rbac.authorization.k8s.io"
    kind      = "ClusterRole"
    name      = "edit"
  }
  subject {
    kind      = "ServiceAccount"
    name      = kubernetes_service_account.spark.metadata[0].name
    namespace = kubernetes_namespace.pipelines.metadata[0].name
  }
}

# ── Secrets ───────────────────────────────────────────────────────────────────

resource "kubernetes_secret" "pipeline_secrets" {
  metadata {
    name      = "customer360-kafka-to-postgresql-secrets"
    namespace = kubernetes_namespace.pipelines.metadata[0].name
  }
  data = {
    "DW_POSTGRES_HOST"     = var.sink_host
    "DW_POSTGRES_PASSWORD" = var.sink_password
    "KAFKA_BROKERS" = var.kafka_brokers
  }
}

# ── SparkApplication CRD ──────────────────────────────────────────────────────

resource "kubernetes_manifest" "spark_pipeline" {
  manifest = {
    apiVersion = "sparkoperator.k8s.io/v1beta2"
    kind       = "SparkApplication"
    metadata = {
      name      = "customer360-kafka-to-postgresql"
      namespace = kubernetes_namespace.pipelines.metadata[0].name
      labels = {
        "app"              = "customer360-kafka-to-postgresql"
        "managed-by"       = "canvode"
        "pipeline-version" = var.pipeline_version
      }
    }
    spec = {
      type                = "Python"
      pythonVersion       = "3"
      mode                = "cluster"
      image               = "${var.spark_image}"
      imagePullPolicy     = "Always"
      mainApplicationFile = "local:///app/pipeline.py"
      sparkVersion        = "3.5.0"
      timeToLiveSeconds   = 86400
      restartPolicy = {
        type                = "OnFailure"
        onFailureRetries    = 3
        onFailureRetryInterval = 10
        onSubmissionFailureRetries = 5
      }
      driver = {
        cores      = 1
        coreLimit  = "1200m"
        memory     = "1g"
        serviceAccount = kubernetes_service_account.spark.metadata[0].name
        envFrom = [{
          secretRef = { name = kubernetes_secret.pipeline_secrets.metadata[0].name }
        }]
        labels = {
          "version" = var.pipeline_version
        }
      }
      executor = {
        cores      = var.executor_cores
        instances  = var.executor_instances
        memory     = var.executor_memory
        envFrom = [{
          secretRef = { name = kubernetes_secret.pipeline_secrets.metadata[0].name }
        }]
      }
      sparkConf = {
        "spark.sql.adaptive.enabled"                        = "true"
        "spark.sql.adaptive.coalescePartitions.enabled"     = "true"
        "spark.sql.sources.partitionOverwriteMode"          = "dynamic"
        "spark.sql.shuffle.partitions"                      = "200"
        
        
        
        
      }
    }
  }
  depends_on = [helm_release.spark_operator]
}

# ── Production schedule ───────────────────────────────────────────────────────

# Scheduled SparkApplication

resource "kubernetes_manifest" "scheduled_spark_pipeline" {
  manifest = {
    apiVersion = "sparkoperator.k8s.io/v1beta2"
    kind       = "ScheduledSparkApplication"
    metadata = {
      name      = "customer360-kafka-to-postgresql-schedule"
      namespace = kubernetes_namespace.pipelines.metadata[0].name
      labels = {
        "app"        = "customer360-kafka-to-postgresql"
        "managed-by" = "canvode"
      }
    }
    spec = {
      schedule                  = "0 2 * * *"
      concurrencyPolicy         = "Forbid"
      successfulRunHistoryLimit = 3
      failedRunHistoryLimit     = 5
      template                  = kubernetes_manifest.spark_pipeline.manifest.spec
    }
  }
  depends_on = [kubernetes_manifest.spark_pipeline]
}

